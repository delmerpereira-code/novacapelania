# Copie para .env (nunca commitar o .env de verdade) e preencha com os
# valores do seu projeto: painel Supabase > Project Settings > API.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Service role key: só usar em scripts locais/servidor, nunca no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Caminhos dos CSVs exportados das abas Cadastro e Equipes da planilha antiga.
CADASTRO_CSV_PATH=./data/cadastro.csv
EQUIPES_CSV_PATH=./data/equipes.csv

# --- Deploy da Edge Function (supabase/functions/login) ---
# Project Settings > API > JWT Keys > "Legacy JWT Secret" (revelar e copiar).
# É o segredo que a Edge Function usa pra assinar o token de login.
JWT_SECRET=

# Referência do projeto (parte antes de ".supabase.co" na URL).
SUPABASE_PROJECT_REF=

# Personal Access Token pra CLI conseguir fazer deploy: dashboard ->
# ícone da sua conta (canto superior direito) -> Access Tokens -> Generate
# new token. Só usado localmente pra rodar `supabase functions deploy`.
SUPABASE_ACCESS_TOKEN=
